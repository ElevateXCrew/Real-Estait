# EmailJS — https://dashboard.emailjs.com
# Copy this file to .env (or .env.local) and fill in your own values.
EMAILJS_PUBLIC_KEY=your_public_key
# Required when "strict mode" is enabled in EmailJS Account > Security
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_SERVICE_ID=service_xxxxxxx
# Set a custom Template ID in EmailJS (e.g. template_contact_form); default IDs can change
EMAILJS_TEMPLATE_ID=template_contact_form

# Inbox that receives website form submissions
CONTACT_TO_EMAIL=myprojects.faraz@gmail.com
